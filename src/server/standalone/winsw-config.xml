<service>
  <id>MicroGennMirmSync</id>
  <name>MicroGenn MIRM Sync Service</name>
  <description>MICROGENN IRM/MHMS PMS Node.js Synchronization Unit - Syncs bookings, inventory, and acknowledgements.</description>
  <executable>node.exe</executable>
  <arguments>mirm-sync.js</arguments>
  <logmode>rotate</logmode>
  <logpath>%BASE%\logs</logpath>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="20 sec"/>
  <resetfailure>1 hour</resetfailure>
  <priority>Normal</priority>
  <stoptimeout>15 sec</stoptimeout>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalSystem</user>
  </serviceaccount>
</service>
